---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#horizon', label: 'Horizon' },
  { href: '#open', label: 'Open source' },
];
---

<header class="header">
  <div class="inner">
    <a href="#top" class="logo">Nilovon</a>
    <nav class="nav mono" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="#contact" class="cta">Get in touch</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    background: rgb(18 18 16 / 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    padding: 16px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .logo {
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.02em;
    font-stretch: 125%;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 26px;
  }

  .cta {
    background: var(--accent);
    color: var(--ink);
    padding: 8px 12px;
    transition: background-color 0.2s;
  }
  .cta:hover {
    background: var(--paper);
    color: var(--ink);
  }

  @media (max-width: 859px) {
    .inner {
      padding: 14px var(--gutter);
    }
    .nav a:not(.cta) {
      display: none;
    }
  }
</style>
