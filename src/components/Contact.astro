---
const year = new Date().getFullYear();
---

<section id="contact" class="section contact">
  <h2>Have an idea, a bug report or a <span class="hl">question</span>?</h2>
  <p>Write to us, or open an issue in the repository it is about.</p>
  <a href="mailto:hello@nilovon.com" class="email">hello@nilovon.com</a>
</section>

<footer class="footer">
  <span>© {year} Nilovon</span>
  <nav aria-label="Footer">
    <a href="https://github.com/Nilovon">GitHub</a>
    <a href="mailto:hello@nilovon.com">Email</a>
  </nav>
</footer>

<style>
  .contact {
    text-align: center;
  }

  h2 {
    max-width: 18ch;
    margin-inline: auto;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  p {
    margin-top: 20px;
    font-size: 17px;
    color: var(--ink-2);
  }

  .email {
    display: inline-block;
    margin-top: 40px;
    font-size: clamp(26px, 4.4vw, 48px);
    font-weight: 600;
    letter-spacing: -0.03em;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 4px;
    transition:
      color 0.18s,
      border-color 0.18s;
  }

  .email:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding: 24px var(--gutter);
    border-top: 1px dashed var(--rule);
    font-size: 14px;
    color: var(--ink-3);
  }

  .footer nav {
    display: flex;
    gap: 20px;
  }

  .footer a:hover {
    color: var(--ink);
  }
</style>
