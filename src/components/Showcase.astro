---
import { products, pad } from '../data/products';

const railLabels = ['Index', ...products.map((p) => p.name)];
---

<section id="top" class="showcase" data-showcase>
  <div id="work" class="work-anchor" aria-hidden="true"></div>
  <div class="stage" data-stage>
    <div class="panels">
      <div class="panel hero" data-panel data-state="active">
        <div class="mono muted">Software studio — Germany</div>
        <h1>We build tools that developers <span class="hl">actually</span> want to use.</h1>
        <p class="lead">
          Nilovon is a small software studio from Germany. We make open source SDKs, developer
          tools, and business software — built with TypeScript, modern standards, and care.
        </p>
        <div class="actions">
          <a href="#work" class="btn btn-light">See our work ↓</a>
          <a href="https://github.com/Nilovon" class="btn btn-ghost">GitHub ↗</a>
        </div>
        <div class="facts">
          <span>TypeScript end to end</span>
          <span>EU hosted · Frankfurt</span>
          <span>DSGVO-konform</span>
          <span>Two SDKs open source</span>
        </div>
      </div>

      {
        products.map((p, i) => (
          <article id={p.id} class="panel product" data-panel data-state="future" inert>
            <div class="meta mono">
              <span class="marker" data-marker />
              <span class="muted">
                {pad(i + 1)} / {p.kind}
              </span>
              <span class:list={['badge', p.badge.variant]}>{p.badge.label}</span>
            </div>
            <h2 class="display name">{p.name}</h2>
            <div class="tagline">{p.tagline}</div>
            <p class="description">{p.description}</p>
            <ol class="features">
              {p.features.map((f, j) => (
                <li>
                  <span class="num">{pad(j + 1)}</span>
                  {f}
                </li>
              ))}
            </ol>
            <div class="footer">
              <a href={p.href} class="btn btn-light">
                {p.cta} ↗
              </a>
              <span class="stack">{p.stack}</span>
            </div>
          </article>
        ))
      }
    </div>

    <div class="viewport">
      <div class="mount" data-mount></div>
      <div class="fig-label mono" data-fig-label>Fig. 0 — Assembled · drag to rotate</div>
      <nav class="rail mono" aria-label="Showcase sections">
        {
          railLabels.map((label, i) => (
            <button type="button" data-go={i} aria-current={i === 0 ? 'step' : undefined}>
              {pad(i)} {label}
              <span class="bar" />
            </button>
          ))
        }
      </nav>
    </div>

    <svg class="connector" aria-hidden="true">
      <polyline data-line points="0,0" opacity="0"></polyline>
      <circle data-dot cx="0" cy="0" r="4" opacity="0"></circle>
    </svg>
  </div>
</section>

<script>
  import { initShowcase } from '../scripts/showcase';

  const section = document.querySelector<HTMLElement>('[data-showcase]');
  if (section) {
    const controller = initShowcase(section);
    import('../scripts/scene')
      .then(({ initScene }) => initScene(section, controller))
      .catch((err) => console.warn('3D scene unavailable:', err));
  }
</script>

<style>
  .showcase {
    position: relative;
    height: 460vh;
  }

  .work-anchor {
    position: absolute;
    top: 25%;
    width: 1px;
    height: 1px;
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  }

  .panels {
    position: relative;
    min-width: 0;
    min-height: 0;
    border-right: 1px solid var(--line);
  }

  .panel {
    position: absolute;
    inset: 0;
    padding: 96px var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    gap: 22px;
    overflow: auto;
    transition:
      opacity 0.5s,
      transform 0.6s var(--ease-out);
  }

  .panel[data-state='active'] {
    opacity: 1;
    transform: none;
  }
  .panel[data-state='past'],
  .panel[data-state='future'] {
    opacity: 0;
    pointer-events: none;
  }
  .panel[data-state='past'] {
    transform: translateY(-28px);
  }
  .panel[data-state='future'] {
    transform: translateY(28px);
  }

  .muted {
    color: var(--text-3);
  }

  .hl {
    color: var(--accent);
  }

  /* Hero */
  .hero {
    gap: 32px;
  }

  h1 {
    margin: 0;
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(34px, 3.8vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .lead {
    margin: 0;
    max-width: 44ch;
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 15px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 520px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-2);
  }
  .facts span {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  /* Product */
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .marker {
    display: block;
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .badge.outline {
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 3px 7px;
  }
  .badge.solid {
    background: var(--accent);
    color: var(--ink);
    padding: 4px 8px;
  }

  .name {
    margin: 0;
    font-size: clamp(40px, 4.8vw, 80px);
    line-height: 0.9;
  }

  .tagline {
    max-width: 30ch;
    font-size: 21px;
    line-height: 1.3;
    font-weight: 500;
  }

  .description {
    margin: 0;
    max-width: 58ch;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 640px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    column-gap: 24px;
    border-top: 1px solid var(--line);
  }
  .features li {
    display: flex;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.4;
  }
  .num {
    padding-top: 2px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }

  .footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .footer .btn {
    padding: 13px 20px;
    font-size: 14px;
  }
  .stack {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-3);
  }

  /* 3D viewport */
  .viewport {
    position: relative;
    min-width: 0;
    min-height: 0;
  }

  .mount {
    position: absolute;
    inset: 0;
  }

  .mount :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
    cursor: grab;
  }

  .fig-label {
    position: absolute;
    left: 24px;
    bottom: 24px;
    font-size: 11px;
    color: var(--text-4);
    pointer-events: none;
  }

  .rail {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 11px;
  }

  .rail button {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--text-4);
    cursor: pointer;
    transition: color 0.3s;
  }
  .rail button:hover,
  .rail button[aria-current] {
    color: var(--accent);
  }

  .bar {
    display: block;
    width: 10px;
    height: 1px;
    background: currentColor;
    transition: width 0.3s;
  }
  .rail button[aria-current] .bar {
    width: 28px;
  }

  .connector {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .connector polyline {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1;
  }
  .connector circle {
    fill: var(--accent);
  }

  @media (max-width: 859px) {
    .stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 38vh minmax(0, 1fr);
    }
    .viewport {
      order: -1;
    }
    .panels {
      border-right: 0;
    }
    .panel {
      padding: 28px var(--gutter) 32px;
    }
    .fig-label,
    .rail,
    .connector {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      transition: opacity 0.2s;
    }
    .panel[data-state] {
      transform: none;
    }
  }
</style>
