---
import { products } from '../data/products';

const repos = products.filter((p) => p.openSource);
---

<section id="open">
  <div class="container grid">
    <div class="intro">
      <span class="eyebrow">Open source</span>
      <h2>Built in the <span class="hl">open</span></h2>
      <p>
        We believe the best developer tools are built transparently. BucketKit and hcloud-js are
        fully open source today. We publish our work, accept contributions, and build in public.
      </p>
      <a href="https://github.com/Nilovon" class="btn btn-accent">View on GitHub ↗</a>
    </div>
    <ul class="repos">
      {
        repos.map((r) => (
          <li>
            <a href={r.href}>
              <span class="display name">{r.name}</span>
              <span class="mono">Public repo ↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 56px;
    padding-block: 120px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
  }

  h2 {
    margin: 0;
    font-weight: 700;
    font-stretch: 112%;
    font-size: clamp(40px, 5vw, 76px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  .hl {
    color: var(--accent);
  }

  p {
    margin: 0;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .btn {
    padding: 15px 24px;
    font-size: 15px;
  }

  .repos {
    list-style: none;
    margin: 0;
    padding: 0;
    align-self: end;
    border-top: 1px solid var(--line);
  }

  .repos a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }

  .name {
    font-size: clamp(26px, 2.8vw, 42px);
    line-height: 1;
  }
</style>
