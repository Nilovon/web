---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <span>Nilovon — Building modern software.</span>
    <div class="links">
      <a href="https://github.com/Nilovon">GitHub</a>
      <a href="mailto:hello@nilovon.com">Email</a>
      <span>© {year} Nilovon. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    color: var(--text-3);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
</style>
