---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Products from '../components/Products.astro';
import Principles from '../components/Principles.astro';
import Contact from '../components/Contact.astro';
---

<Base
  title="Nilovon · Software studio from Germany"
  description="Nilovon is a small software studio from Germany. We build Lumvika, BucketKit and hcloud-js: self-hostable tools and typesafe SDKs in TypeScript, all open source."
>
  <div class="frame">
    <Nav />
    <main>
      <Hero />
      <Products />
      <Principles />
      <Contact />
    </main>
  </div>
</Base>
